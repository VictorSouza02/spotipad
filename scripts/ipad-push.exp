#!/usr/bin/expect -f
# Copy a local file to the iPad. Usage: ipad-push.exp <local> <remote>. Same env as ipad-ssh.exp.
set timeout -1
set src [lindex $argv 0]
set dst [lindex $argv 1]
if {![info exists env(IPAD_PASS)]} { puts "IPAD_PASS not set"; exit 2 }
if {![info exists env(IPAD_HOST)]} { puts "IPAD_HOST not set"; exit 2 }
set host $env(IPAD_HOST)
set opts [list -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedKeyTypes=+ssh-rsa -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 -o PreferredAuthentications=password -o PubkeyAuthentication=no]
if {[info exists env(IPAD_JUMP)] && $env(IPAD_JUMP) ne ""} { lappend opts -o ProxyJump=$env(IPAD_JUMP) }
spawn scp {*}$opts $src root@$host:$dst
expect {
  -re "(?i)password:" { send "$env(IPAD_PASS)\r"; exp_continue }
  eof
}
